<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="Browsing" android:key="category_browsing" />
    <androidx.preference.Preference android:key="ani_search" android:title="Default search engine" />
    <androidx.preference.Preference android:key="ani_dns" android:title="@string/dns_provider_title" />
    <androidx.preference.Preference android:key="ani_dns_info" android:summary="@string/dns_explanation" android:selectable="false" />

    <androidx.preference.Preference
            android:key="@string/pref_key_sign_in" app:isPreferenceVisible="false"
            android:title="@string/sign_in"
            android:summary="@string/preferences_sign_in_summary"/>

    <androidx.preference.Preference
        android:key="@string/pref_key_pair_sign_in" app:isPreferenceVisible="false"
        android:title="@string/pair_sign_in"
        android:summary="@string/preferences_pair_sign_in_summary"/>

    <androidx.preference.Preference
        android:key="@string/pref_key_firefox_account" app:isPreferenceVisible="false"
        android:title="@string/firefox_account" />

    <androidx.preference.Preference
        android:key="@string/pref_key_privacy"
        android:title="@string/privacy"
        android:summary="@string/preferences_privacy_summary"/>

    <androidx.preference.SwitchPreferenceCompat
        android:key="@string/pref_key_launch_external_app"
        android:defaultValue="false"
        android:title="@string/open_links_in_apps" />

    <androidx.preference.Preference
            android:key="@string/pref_key_make_default_browser"
            android:title="@string/preferences_make_default_browser"/>

    <org.mozilla.reference.browser.autofill.AutofillPreference
        android:key="@string/pref_key_autofill"
        android:title="@string/preferences_autofill"
        android:summary="@string/preferences_autofill_summary" />

    <PreferenceCategory android:title="Playback" android:key="category_playback">
        <androidx.preference.SwitchPreferenceCompat android:key="background_play" android:title="Background play" android:summary="Keep audio playing outside the browser. Per-site choices apply when enabled." android:defaultValue="true" />
        <androidx.preference.SwitchPreferenceCompat android:key="picture_in_picture" android:title="Picture-in-Picture" android:summary="Float playing video when leaving the browser. Per-site choices apply when enabled." android:defaultValue="true" />
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/developer_tools_category">

        <androidx.preference.SwitchPreferenceCompat
            android:key="@string/pref_key_remote_debugging"
            android:defaultValue="false"
            android:title="@string/preferences_remote_debugging" />

        <androidx.preference.Preference
            android:key="@string/pref_key_override_amo_collection"
            android:title="@string/preferences_customize_amo_collection"/>

    </PreferenceCategory>

    <PreferenceCategory
        android:title="AniBrowser">

        <androidx.preference.SwitchPreferenceCompat
            android:key="pref_key_adshield"
            android:defaultValue="true"
            android:title="Ad Shield"
            android:summary="Block intrusive ads, popup scripts, and tracking redirects" />

        <androidx.preference.Preference
            android:key="@string/pref_key_about_page"
            android:title="@string/preferences_about_page" />

    </PreferenceCategory>

</androidx.preference.PreferenceScreen>
