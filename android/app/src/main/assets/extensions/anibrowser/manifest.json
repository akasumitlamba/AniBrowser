{
  "manifest_version": 2,
  "name": "AniBrowser Playback",
  "version": "0.3.3",
  "browser_specific_settings": {
    "gecko": {
      "id": "playback@anibrowser.local"
    }
  },
  "permissions": [
    "nativeMessaging",
    "geckoViewAddons",
    "tabs",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "adblocker.js",
        "playback.js",
        "pip.js",
        "fullscreen.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "viewport.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ]
}
